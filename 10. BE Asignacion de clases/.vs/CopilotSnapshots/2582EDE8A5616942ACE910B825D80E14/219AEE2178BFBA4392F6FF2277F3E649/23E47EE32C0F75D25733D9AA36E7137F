using UadeAulas.Api.Dtos;
using UadeAulas.Api.Services;

namespace UadeAulas.Api.Endpoints;

public static class ImportEndpoints
{
    public static void MapImportEndpoints(this WebApplication app)
    {
        app.MapGroup("/import")
            .WithTags("Import")
            .MapPost("/aulas", ImportarAulas)
            .WithName("ImportarAulas")
            .Produces<ImportResultDto>()
            .Produces(400)
            .DisableAntiforgery();
    }

    public static async Task<IResult> ImportarAulas(AulaImportService service, IFormFile archivo)
    {
        if (archivo.Length == 0)
            return Results.BadRequest(new { error = "El archivo está vacío." });

        try
        {
            using var stream = archivo.OpenReadStream();
            var resultado = await service.ImportarAsync(stream);
            return Results.Ok(resultado);
        }
        catch (Exception ex)
        {
            return Results.BadRequest(new { error = ex.Message });
        }
    }
}
