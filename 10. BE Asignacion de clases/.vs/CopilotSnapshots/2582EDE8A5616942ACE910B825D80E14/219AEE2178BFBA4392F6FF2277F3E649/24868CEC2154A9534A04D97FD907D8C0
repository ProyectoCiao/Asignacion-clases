using Npgsql;
using UadeAulas.Api.Models;
using System.Collections.Generic;
using System.Threading.Tasks;

namespace UadeAulas.Api.Data;

public class Repository
{
    private readonly string _connectionString;

    public Repository(IConfiguration configuration)
    {
        _connectionString = configuration.GetConnectionString("DefaultConnection") 
            ?? throw new InvalidOperationException("Connection string not found");
    }

    private async Task<NpgsqlConnection> GetConnectionAsync()
    {
        var connection = new NpgsqlConnection(_connectionString);
        await connection.OpenAsync();
        return connection;
    }

    // Sedes
    public async Task<List<Sede>> GetSedesAsync()
    {
        var sedes = new List<Sede>();
        using var conn = await GetConnectionAsync();
        using var cmd = new NpgsqlCommand("SELECT id, codigo, nombre FROM sede ORDER BY nombre", conn);
        using var reader = await cmd.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            sedes.Add(new Sede
            {
                Id = reader.GetInt32(0),
                Codigo = reader.GetString(1),
                Nombre = reader.GetString(2)
            });
        }
        return sedes;
    }

    // Aulas
    public async Task<List<Aula>> GetAulasAsync(int? sedeId = null)
    {
        var aulas = new List<Aula>();
        using var conn = await GetConnectionAsync();

        var query = @"SELECT id, sede_id, codigo, tipo_grupo, tipo_detalle, piso, 
                           capacidad_real, capacidad_total, equipamiento, activa, edificio 
                    FROM aula";

        if (sedeId.HasValue)
            query += " WHERE sede_id = @sedeId";

        query += " ORDER BY codigo";

        using var cmd = new NpgsqlCommand(query, conn);
        if (sedeId.HasValue)
            cmd.Parameters.AddWithValue("@sedeId", sedeId.Value);

        using var reader = await cmd.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            aulas.Add(new Aula
            {
                Id = reader.GetInt32(0),
                SedeId = reader.GetInt32(1),
                Codigo = reader.GetString(2),
                TipoGrupo = reader.GetString(3),
                TipoDetalle = reader.IsDBNull(4) ? null : reader.GetString(4),
                Piso = reader.GetInt32(5),
                CapacidadReal = reader.GetInt32(6),
                CapacidadTotal = reader.GetInt32(7),
                Equipamiento = reader.IsDBNull(8) ? null : (string[])reader.GetValue(8),
                Activa = reader.GetBoolean(9),
                Edificio = reader.IsDBNull(10) ? null : reader.GetString(10)
            });
        }
        return aulas;
    }

    // Busca una sede por nombre (case-insensitive); si no existe la crea con codigo derivado del nombre.
    public async Task<int> GetOrCreateSedeIdAsync(string nombreSede)
    {
        using var conn = await GetConnectionAsync();
        using (var cmdSelect = new NpgsqlCommand("SELECT id FROM sede WHERE UPPER(nombre) = UPPER(@nombre) OR UPPER(codigo) = UPPER(@nombre)", conn))
        {
            cmdSelect.Parameters.AddWithValue("@nombre", nombreSede);
            var existingId = await cmdSelect.ExecuteScalarAsync();
            if (existingId != null)
                return (int)existingId;
        }

        var codigo = nombreSede.Trim().ToUpperInvariant().Replace(" ", "_");
        using var cmdInsert = new NpgsqlCommand(
            "INSERT INTO sede (codigo, nombre) VALUES (@codigo, @nombre) RETURNING id", conn);
        cmdInsert.Parameters.AddWithValue("@codigo", codigo);
        cmdInsert.Parameters.AddWithValue("@nombre", nombreSede.Trim());
        return (int)(await cmdInsert.ExecuteScalarAsync())!;
    }

    // Upsert de aula por (sede_id, codigo). Devuelve el id del aula insertada/actualizada.
    public async Task<int> UpsertAulaAsync(Aula aula)
    {
        using var conn = await GetConnectionAsync();
        using var cmd = new NpgsqlCommand(@"
            INSERT INTO aula (sede_id, codigo, tipo_grupo, tipo_detalle, piso, capacidad_real, capacidad_total, equipamiento, activa, edificio)
            VALUES (@sedeId, @codigo, @tipoGrupo, @tipoDetalle, @piso, @capacidadReal, @capacidadTotal, @equipamiento, @activa, @edificio)
            ON CONFLICT (sede_id, codigo) DO UPDATE SET
                tipo_grupo = EXCLUDED.tipo_grupo,
                tipo_detalle = EXCLUDED.tipo_detalle,
                piso = EXCLUDED.piso,
                capacidad_real = EXCLUDED.capacidad_real,
                capacidad_total = EXCLUDED.capacidad_total,
                edificio = EXCLUDED.edificio,
                activa = EXCLUDED.activa
            RETURNING id", conn);
        cmd.Parameters.AddWithValue("@sedeId", aula.SedeId);
        cmd.Parameters.AddWithValue("@codigo", aula.Codigo);
        cmd.Parameters.AddWithValue("@tipoGrupo", aula.TipoGrupo);
        cmd.Parameters.AddWithValue("@tipoDetalle", (object?)aula.TipoDetalle ?? DBNull.Value);
        cmd.Parameters.AddWithValue("@piso", aula.Piso);
        cmd.Parameters.AddWithValue("@capacidadReal", aula.CapacidadReal);
        cmd.Parameters.AddWithValue("@capacidadTotal", aula.CapacidadTotal);
        cmd.Parameters.AddWithValue("@equipamiento", (object?)aula.Equipamiento ?? DBNull.Value);
        cmd.Parameters.AddWithValue("@activa", aula.Activa);
        cmd.Parameters.AddWithValue("@edificio", (object?)aula.Edificio ?? DBNull.Value);
        return (int)(await cmd.ExecuteScalarAsync())!;
    }

    public async Task<Aula?> GetAulaByCodigoAsync(string codigo, int sedeId)
    {
        using var conn = await GetConnectionAsync();
        using var cmd = new NpgsqlCommand(@"SELECT id, sede_id, codigo, tipo_grupo, tipo_detalle, piso,
                           capacidad_real, capacidad_total, equipamiento, activa, edificio
                    FROM aula WHERE codigo = @codigo AND sede_id = @sedeId", conn);
        cmd.Parameters.AddWithValue("@codigo", codigo);
        cmd.Parameters.AddWithValue("@sedeId", sedeId);
        using var reader = await cmd.ExecuteReaderAsync();
        if (!await reader.ReadAsync())
            return null;

        return new Aula
        {
            Id = reader.GetInt32(0),
            SedeId = reader.GetInt32(1),
            Codigo = reader.GetString(2),
            TipoGrupo = reader.GetString(3),
            TipoDetalle = reader.IsDBNull(4) ? null : reader.GetString(4),
            Piso = reader.GetInt32(5),
            CapacidadReal = reader.GetInt32(6),
            CapacidadTotal = reader.GetInt32(7),
            Equipamiento = reader.IsDBNull(8) ? null : (string[])reader.GetValue(8),
            Activa = reader.GetBoolean(9),
            Edificio = reader.IsDBNull(10) ? null : reader.GetString(10)
        };
    }

