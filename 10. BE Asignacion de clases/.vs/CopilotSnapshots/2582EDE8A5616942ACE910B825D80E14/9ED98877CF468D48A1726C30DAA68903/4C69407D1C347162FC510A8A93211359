-- ==================== CARGAR DEMANDA_SNAPSHOT ====================
-- Solicitudes de inscripción por materia (independiente de la oferta de clases).
-- Se calcula con un factor de demanda sobre el total de inscriptos actuales para simular
-- escenarios donde la demanda supera o no a la oferta disponible.
INSERT INTO demanda_snapshot (materia_codigo, solicitudes)
SELECT materia_codigo, CEIL(SUM(inscriptos) * 1.15)::INT
FROM clase
GROUP BY materia_codigo;

-- ==================== ASIGNAR AULA A CADA CLASE (tabla ASIGNACION) ====================
-- Asigna un aula de la misma sede en forma round-robin y calcula sillas vacías
-- (capacidad_total del aula - inscriptos_con_reserva de la clase).
WITH clase_ordenada AS (
	SELECT id, sede_id, inscriptos_con_reserva,
		   ROW_NUMBER() OVER (PARTITION BY sede_id ORDER BY id) AS rn
	FROM clase
),
aula_ordenada AS (
	SELECT id, sede_id, capacidad_total,
		   ROW_NUMBER() OVER (PARTITION BY sede_id ORDER BY capacidad_total DESC) AS rn,
		   COUNT(*) OVER (PARTITION BY sede_id) AS total
	FROM aula
)
INSERT INTO asignacion (clase_id, aula_id, origen, sillas_vacias)
SELECT co.id, a.id, 'REPLICA', a.capacidad_total - co.inscriptos_con_reserva
FROM clase_ordenada co
JOIN aula_ordenada a
  ON a.sede_id = co.sede_id
 AND a.rn = ((co.rn - 1) % a.total) + 1;

-- ==================== ASIGNAR DOCENTES A CADA CLASE ====================
INSERT INTO clase_docente (clase_id, docente_id)
SELECT c.id, (1 + (c.id % (SELECT COUNT(*) FROM docente)))::INT
FROM clase c;

