-- ==================== CREAR TABLAS (esquema real usado por Repository.cs) ====================

CREATE TABLE sede (
	id SERIAL PRIMARY KEY,
	codigo VARCHAR(50) NOT NULL UNIQUE,
	nombre VARCHAR(255) NOT NULL
);

CREATE TABLE periodo (
	id SERIAL PRIMARY KEY,
	ciclo VARCHAR(50) NOT NULL,
	nombre VARCHAR(255) NOT NULL,
	fecha_desde DATE NOT NULL,
	fecha_hasta DATE NOT NULL
);

CREATE TABLE materia (
	codigo VARCHAR(50) PRIMARY KEY,
	nombre VARCHAR(255) NOT NULL,
	facultad VARCHAR(255),
	departamento VARCHAR(255),
	carga_horaria INT DEFAULT 0
);

CREATE TABLE docente (
	id SERIAL PRIMARY KEY,
	nombre VARCHAR(255) NOT NULL
);

CREATE TABLE aula (
	id SERIAL PRIMARY KEY,
	sede_id INT NOT NULL REFERENCES sede(id),
	codigo VARCHAR(50) NOT NULL,
	tipo_grupo VARCHAR(50) NOT NULL,
	tipo_detalle VARCHAR(255),
	piso INT NOT NULL,
	capacidad_real INT NOT NULL,
	capacidad_total INT NOT NULL,
	equipamiento TEXT[],
	activa BOOLEAN DEFAULT true,
	edificio VARCHAR(255)
);

CREATE TABLE clase (
	id BIGSERIAL PRIMARY KEY,
	nro_clase INT NOT NULL,
	periodo_id INT NOT NULL REFERENCES periodo(id),
	sede_id INT NOT NULL REFERENCES sede(id),
	materia_codigo VARCHAR(50) NOT NULL REFERENCES materia(codigo),
	turno VARCHAR(50) NOT NULL,
	horario_desde TIME NOT NULL,
	horario_hasta TIME NOT NULL,
	dias TEXT[],
	regimen VARCHAR(50) DEFAULT 'PRESENCIAL',
	idioma VARCHAR(50) DEFAULT 'ES',
	modalidad VARCHAR(50) DEFAULT 'REGULAR',
	inscriptos INT DEFAULT 0,
	inscriptos_con_reserva INT DEFAULT 0,
	packs TEXT[]
);

CREATE TABLE clase_docente (
	clase_id BIGINT NOT NULL REFERENCES clase(id),
	docente_id INT NOT NULL REFERENCES docente(id),
	PRIMARY KEY (clase_id, docente_id)
);

CREATE TABLE asignacion (
	id BIGSERIAL PRIMARY KEY,
	clase_id BIGINT NOT NULL UNIQUE REFERENCES clase(id),
	aula_id INT REFERENCES aula(id),
	origen VARCHAR(50) NOT NULL,
	sillas_vacias INT DEFAULT 0
);

CREATE TABLE demanda_snapshot (
	materia_codigo VARCHAR(50) PRIMARY KEY REFERENCES materia(codigo),
	solicitudes INT DEFAULT 0
);

-- Índices para performance
CREATE INDEX idx_clase_periodo ON clase(periodo_id);
CREATE INDEX idx_clase_sede ON clase(sede_id);
CREATE INDEX idx_clase_materia ON clase(materia_codigo);
CREATE INDEX idx_aula_sede ON aula(sede_id);
CREATE INDEX idx_asignacion_clase ON asignacion(clase_id);
CREATE INDEX idx_asignacion_aula ON asignacion(aula_id);
CREATE INDEX idx_clase_docente_clase ON clase_docente(clase_id);
CREATE INDEX idx_clase_docente_docente ON clase_docente(docente_id);

