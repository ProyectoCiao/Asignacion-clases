-- ==================== ASIGNAR AULA A CADA CLASE ====================
-- Asigna un aula de la misma sede cuya capacidad sea >= inscriptos_con_reserva (round-robin)
WITH clase_ordenada AS (
	SELECT id, sede_id, inscriptos_con_reserva,
		   ROW_NUMBER() OVER (PARTITION BY sede_id ORDER BY id) AS rn
	FROM clase
),
aula_ordenada AS (
	SELECT id, sede_id, capacidad,
		   ROW_NUMBER() OVER (PARTITION BY sede_id ORDER BY capacidad DESC) AS rn,
		   COUNT(*) OVER (PARTITION BY sede_id) AS total
	FROM aula
)
UPDATE clase c
SET aula_id = a.id
FROM clase_ordenada co
JOIN aula_ordenada a
  ON a.sede_id = co.sede_id
 AND a.rn = ((co.rn - 1) % a.total) + 1
WHERE c.id = co.id;

