-- Script para resetear la BD - Solo tablas necesarias para MVP
-- Autor: Assistant
-- Fecha: 2026-09-14

-- DROP de tablas existentes (en orden de dependencia)
DROP TABLE IF EXISTS clase CASCADE;
DROP TABLE IF EXISTS periodo CASCADE;
DROP TABLE IF EXISTS sede CASCADE;
DROP TABLE IF EXISTS materia CASCADE;

-- Crear tabla: SEDE
CREATE TABLE sede (
	id SERIAL PRIMARY KEY,
	codigo VARCHAR(50) NOT NULL UNIQUE,
	nombre VARCHAR(255) NOT NULL
);

-- Crear tabla: PERIODO
CREATE TABLE periodo (
	id SERIAL PRIMARY KEY,
	ciclo VARCHAR(50) NOT NULL,
	nombre VARCHAR(255) NOT NULL,
	fecha_desde DATE NOT NULL,
	fecha_hasta DATE NOT NULL
);

-- Crear tabla: MATERIA
CREATE TABLE materia (
	codigo VARCHAR(50) PRIMARY KEY,
	nombre VARCHAR(255) NOT NULL,
	facultad VARCHAR(255),
	departamento VARCHAR(255),
	carga_horaria INT DEFAULT 0
);

-- Crear tabla: CLASE
CREATE TABLE clase (
	id BIGSERIAL PRIMARY KEY,
	nro_clase VARCHAR(100) NOT NULL,
	periodo_id INT NOT NULL REFERENCES periodo(id),
	sede_id INT NOT NULL REFERENCES sede(id),
	materia_codigo VARCHAR(50) NOT NULL REFERENCES materia(codigo),
	turno VARCHAR(50) NOT NULL,
	dias TEXT[],
	horario_desde TIME NOT NULL,
	horario_hasta TIME NOT NULL,
	inscriptos INT DEFAULT 0,
	inscriptos_con_reserva INT NOT NULL,
	aula_id INT,
	docente_id INT
);

-- Crear tabla: DEMANDA_SNAPSHOT
CREATE TABLE demanda_snapshot (
	id SERIAL PRIMARY KEY,
	materia_codigo VARCHAR(50) NOT NULL UNIQUE REFERENCES materia(codigo),
	solicitudes INT NOT NULL DEFAULT 0,
	fecha_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

